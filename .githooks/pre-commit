#!/bin/sh
# Repo gate (the vsc_AgentFarm pattern): node checks that take seconds and need no Android build.
# Enabled once per clone with:  git config core.hooksPath .githooks
# Never bypassed with --no-verify unless the user authorises it for an emergency.

if ! node test/run-all.js; then
  echo ""
  echo "=================================================="
  echo " COMMIT BLOCKED - the repo gate failed (node test/run-all.js)"
  echo "=================================================="
  exit 1
fi

# Credential guard: the STAGED content of every staged text file (the repo is public).
if ! node tools/scan_staged.js; then
  exit 1
fi

exit 0
